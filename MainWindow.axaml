<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:backs2.ViewModels"
        x:Class="backs2.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="backs2 - Trading Engine"
        Width="1000" Height="600">

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Height="25" Background="#2D2D2D">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="White"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="10,0"/>
        </Border>

        <!-- Tab strip only. TabItems carry no content, so nothing is
             materialized for unselected tabs. -->
        <TabControl DockPanel.Dock="Top"
                    x:CompileBindings="False"
                    SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <TabItem Header="Overview" />
            <TabItem Header="Runner" />
            <TabItem Header="Monte Carlo" />
            <TabItem Header="Metrics" />
            <TabItem Header="Accounts" />
            <TabItem Header="Data" />
            <TabItem Header="Data Automation" />
            <TabItem Header="MT5 Ticks" />
            <TabItem Header="Providers" />
            <TabItem Header="Chart" />
            <TabItem Header="Logs" />
            <TabItem Header="Config" />
        </TabControl>

        <!-- Single content host. Binds to MainViewModel.CurrentVm, which
             returns the ViewModel for ActiveTabIndex. Only that ViewModel
             is resolved from DI; the DataTemplates in App.axaml map it to
             the matching View. -->
        <ContentControl x:CompileBindings="False"
                        Content="{Binding CurrentVm}" />
    </DockPanel>
</Window>