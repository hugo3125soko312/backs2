<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:backs2.Views"
        x:Class="backs2.MainWindow"
        Title="backs2 - Trading Engine"
        Width="1000" Height="600">

    <Window.Styles>
        <!-- Slim Tab Style -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Status Bar: Dark background with White text for contrast -->
        <Border DockPanel.Dock="Bottom" Height="25" Background="#2D2D2D">
            <TextBlock Text="{Binding StatusText}" 
                       Foreground="White" 
                       FontSize="11"
                       VerticalAlignment="Center" 
                       Margin="10,0"/>
        </Border>

        <TabControl>
            <TabItem Header="Chart"><views:ChartView /></TabItem>
            <TabItem Header="Data"><views:DataView /></TabItem>
            <TabItem Header="Builder"><views:StrategyEditorView /></TabItem>
            <TabItem Header="Logs"><views:LogsView /></TabItem>
            <TabItem Header="Config"><views:ConfigView /></TabItem>
        </TabControl>
    </DockPanel>
</Window>