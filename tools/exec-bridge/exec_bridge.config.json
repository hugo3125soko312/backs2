{
  "require_approval": [
    { "name": "git-commit-amend",        "pattern": "(?i)\\bgit\\b[^\\r\\n]*\\bcommit\\b[^\\r\\n]*--amend",              "reason": "rewrites the previous commit" },
    { "name": "git-rebase",              "pattern": "(?i)\\bgit\\b\\s+rebase\\b",                                       "reason": "rewrites commit history" },
    { "name": "git-reset-destructive",   "pattern": "(?i)\\bgit\\b\\s+reset\\b[^\\r\\n]*--(hard|soft|mixed|keep|merge)\\b", "reason": "moves branch pointer, may discard commits" },
    { "name": "git-push-force",          "pattern": "(?i)\\bgit\\b\\s+push\\b[^\\r\\n]*(\\s-f\\b|\\s--force\\b|\\s--force-with-lease\\b|\\s--force-if-includes\\b)", "reason": "overwrites remote history" },
    { "name": "git-push-delete",         "pattern": "(?i)\\bgit\\b\\s+push\\b[^\\r\\n]*(\\s--delete\\b|\\s-d\\b)",       "reason": "deletes remote branch or tag" },
    { "name": "git-filter-branch",       "pattern": "(?i)\\bgit\\b\\s+filter-branch\\b",                               "reason": "rewrites entire history" },
    { "name": "git-filter-repo",         "pattern": "(?i)\\bgit\\b\\s+filter-repo\\b",                                 "reason": "rewrites entire history" },
    { "name": "git-reflog-expire",       "pattern": "(?i)\\bgit\\b\\s+reflog\\s+expire\\b",                            "reason": "removes recovery points" },
    { "name": "git-gc-prune",            "pattern": "(?i)\\bgit\\b\\s+gc\\b[^\\r\\n]*--prune",                          "reason": "deletes unreachable objects" },
    { "name": "git-branch-delete-force", "pattern": "(?i)\\bgit\\b\\s+branch\\b[^\\r\\n]*\\s-D\\b",                     "reason": "force-deletes a branch" },
    { "name": "git-tag-delete",          "pattern": "(?i)\\bgit\\b\\s+tag\\b[^\\r\\n]*\\s-d\\b",                        "reason": "deletes a tag" },
    { "name": "rm-git-dir",              "pattern": "(?i)\\b(Remove-Item|rm|del|rmdir)\\b[^\\r\\n]*\\.git\\b",           "reason": "deletes the .git directory" },
    { "name": "write-into-git-dir",      "pattern": "(?i)>\\s*\\.git[\\\\/]",                                          "reason": "writes directly into .git/" }
  ]
}