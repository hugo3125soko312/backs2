<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Phase 22A — build performance.
         EmitCompilerGeneratedFiles=false: source generators still run, but
         their output is not written to obj/generated on every build.
         Escape hatch: build with -p:EmitCompilerGeneratedFiles=true.
         RunAnalyzersDuringBuild=false: analyzers (Avalonia, CommunityToolkit,
         .NET built-ins) run in the IDE background pass, not on every CLI
         build. The pre-commit verification build overrides this with
         -p:RunAnalyzersDuringBuild=true. -->
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Avalonia" Version="11.0.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.11" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.0.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.0.55" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    <PackageReference Include="Parquet.Net" Version="4.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />

    <!-- Phase 28: Unified Computing Subsystem — DirectX 12 compute backend.
         Source-generator based (kernels compile into the assembly), .NET 8
         native, public NuGet. Device probing happens in the worker process. -->
    <PackageReference Include="ComputeSharp" Version="3.2.0" />

    <!-- Data Automation -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- ocr -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.30.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="data\**\*.cs" />
  </ItemGroup>
</Project>