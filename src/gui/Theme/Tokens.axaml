<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== SURFACES ==================== -->
    <SolidColorBrush x:Key="SurfaceApp"      Color="#0D1117"/>
    <SolidColorBrush x:Key="SurfacePanel"    Color="#161B22"/>
    <SolidColorBrush x:Key="SurfaceElevated" Color="#21262D"/>
    <SolidColorBrush x:Key="SurfaceSunken"   Color="#000000"/>
    <SolidColorBrush x:Key="SurfaceOverlay"  Color="#000000" Opacity="0.40"/>

    <!-- ==================== TEXT ==================== -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#848D97"/>
    <SolidColorBrush x:Key="TextDisabled"  Color="#484F58"/>
    <SolidColorBrush x:Key="TextInverse"   Color="#0D1117"/>

    <!-- ==================== BORDERS ==================== -->
    <SolidColorBrush x:Key="BorderDefault" Color="#30363D"/>

    <!-- ==================== ACCENT ==================== -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#2F81F7"/>
    <SolidColorBrush x:Key="AccentHover"   Color="#458EF7"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#176BE0"/>
    <SolidColorBrush x:Key="AccentFocus"   Color="#2F81F7"/>

    <!-- ==================== SEMANTIC ==================== -->
    <SolidColorBrush x:Key="SemanticSuccess" Color="#238636"/>
    <SolidColorBrush x:Key="SemanticWarn"    Color="#D29922"/>
    <SolidColorBrush x:Key="SemanticDanger"  Color="#F85149"/>

    <!-- ==================== TYPOGRAPHY ==================== -->
    <x:Double x:Key="FontSizeStatus">11</x:Double>
    <x:Double x:Key="FontSizeGrid">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeHeader">16</x:Double>

    <FontFamily x:Key="FontFamilyUi">Inter, Segoe UI, system-ui</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Code, Consolas, Menlo, monospace</FontFamily>

    <!-- ==================== SPACING ==================== -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">12</x:Double>
    <x:Double x:Key="SpacingL">16</x:Double>

    <!-- ==================== RADIUS ==================== -->
    <CornerRadius x:Key="RadiusSm">2</CornerRadius>

    <!-- ==================== SHELL DIMENSIONS ==================== -->
    <x:Double x:Key="RowHeight">26</x:Double>
    <x:Double x:Key="TitleBarHeight">32</x:Double>
    <x:Double x:Key="StatusBarHeight">24</x:Double>
    <x:Double x:Key="NavRailWidth">180</x:Double>

</ResourceDictionary>