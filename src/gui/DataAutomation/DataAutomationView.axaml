<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.DataAutomationView"
             x:DataType="vm:DataAutomationViewModel">
    <TabControl Margin="10">

        <!-- ══════════ EXTRACTION ══════════ -->
        <TabItem Header="Extraction">
            <ScrollViewer>
                <StackPanel Spacing="8" Margin="4">
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="14"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Symbol:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Symbol}" Width="100"/>
                        <TextBlock Text="Timeframe:" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Timeframes}"
                                  SelectedItem="{Binding Timeframe}"
                                  Width="80"/>
                        <TextBlock Text="Steps:" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding StepCount}" Minimum="1" Maximum="100000"
                                       ShowButtonSpinner="False" Width="160"/>
                    </StackPanel>

                    <TextBlock Text="Calibrate each row from TradingView's Data Window (right-click chart → Data Window). Crop only the value, not the label."
                               Foreground="DarkOrange"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Date" Width="60" VerticalAlignment="Center"/>
                            <Button Content="Calibrate"
                                    Command="{Binding CalibrateValueCommand}" CommandParameter="DATE"/>
                            <TextBlock Text="{Binding DateDisplay}"
                                       FontFamily="Consolas" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Time" Width="60" VerticalAlignment="Center"/>
                            <Button Content="Calibrate"
                                    Command="{Binding CalibrateValueCommand}" CommandParameter="TIME"/>
                            <TextBlock Text="{Binding TimeDisplay}"
                                       FontFamily="Consolas" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Open" Width="60" VerticalAlignment="Center"/>
                            <Button Content="Calibrate"
                                    Command="{Binding CalibrateValueCommand}" CommandParameter="O"/>
                            <TextBlock Text="{Binding ODisplay}"
                                       FontFamily="Consolas" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="High" Width="60" VerticalAlignment="Center"/>
                            <Button Content="Calibrate"
                                    Command="{Binding CalibrateValueCommand}" CommandParameter="H"/>
                            <TextBlock Text="{Binding HDisplay}"
                                       FontFamily="Consolas" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Low" Width="60" VerticalAlignment="Center"/>
                            <Button Content="Calibrate"
                                    Command="{Binding CalibrateValueCommand}" CommandParameter="L"/>
                            <TextBlock Text="{Binding LDisplay}"
                                       FontFamily="Consolas" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Close" Width="60" VerticalAlignment="Center"/>
                            <Button Content="Calibrate"
                                    Command="{Binding CalibrateValueCommand}" CommandParameter="C"/>
                            <TextBlock Text="{Binding CDisplay}"
                                       FontFamily="Consolas" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Vol" Width="60" VerticalAlignment="Center"/>
                            <Button Content="Calibrate"
                                    Command="{Binding CalibrateValueCommand}" CommandParameter="V"/>
                            <TextBlock Text="{Binding VDisplay}"
                                       FontFamily="Consolas" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Anchor" Width="60" VerticalAlignment="Center"/>
                            <Button Content="Calibrate"
                                    Command="{Binding CalibrateClickCommand}"/>
                            <TextBlock Text="{Binding ClickDisplay}"
                                       FontFamily="Consolas" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Enter TradingView Bar Replay before clicking Start. The anchor point must be empty space to the right of the newest candle. Step delay is measured automatically."
                               Foreground="DarkOrange"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Start Automation"
                                Command="{Binding StartAutomationCommand}"
                                Padding="16,6"/>
                        <Button Content="Stop"
                                Command="{Binding StopAutomationCommand}"
                                Padding="16,6"/>
                        <Button Content="Preview Calibration"
                                Command="{Binding PreviewCalibrationCommand}"
                                Padding="16,6"/>
                        <Button Content="Clear All"
                                Command="{Binding ClearCalibrationCommand}"/>
                    </StackPanel>

                    <ProgressBar Value="{Binding ExtractionProgress}"
                                 Minimum="0" Maximum="100"
                                 Height="14"/>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Elapsed:" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock Text="{Binding ElapsedDisplay}"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="ETA:" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock Text="{Binding EtaDisplay}"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="DeepSkyBlue"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Delay:" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock Text="{Binding DelayDisplay}"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="LightGreen"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Per step:" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock Text="{Binding PerStepDisplay}"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,8,0,4"/>

                    <TextBlock Text="Re-extract Missing Steps" FontWeight="Bold" FontSize="13"/>

                    <TextBlock Text="Paste step indices from data/parsed/{symbol}_{timeframe}_misses.txt (one per line or comma-separated). The automation will re-walk the chart and overwrite only those crops. TradingView state must match the previous extraction run."
                               Foreground="DarkOrange"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding ReExtractInput}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="100"
                                 Width="420"
                                 FontFamily="Consolas"
                                 Watermark="139, 186, 228, ..."/>
                        <StackPanel Spacing="6" VerticalAlignment="Top">
                            <Button Content="Re-extract Missing"
                                    Command="{Binding ReExtractCommand}"
                                    Padding="16,6"/>
                            <Button Content="Stop"
                                    Command="{Binding StopReExtractCommand}"
                                    Padding="16,6"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ══════════ PARSING ══════════ -->
        <TabItem Header="Parsing">
            <ScrollViewer>
                <StackPanel Spacing="12" Margin="4" Width="620" HorizontalAlignment="Left">
                    <TextBlock Text="OCR Extraction" FontWeight="Bold" FontSize="14"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Ticker:" VerticalAlignment="Center" Width="70"/>
                        <TextBox Text="{Binding ParseTicker}" Width="140"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Timeframe:" VerticalAlignment="Center" Width="70"/>
                        <ComboBox ItemsSource="{Binding Timeframes}"
                                  SelectedItem="{Binding ParseTimeframe}"
                                  Width="100"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Device:" VerticalAlignment="Center" Width="70"/>
                        <RadioButton Content="CPU" GroupName="ParseDevice"
                                     IsChecked="{Binding !UseGpu}"
                                     VerticalAlignment="Center"/>
                        <RadioButton Content="GPU (CUDA)" GroupName="ParseDevice"
                                     IsChecked="{Binding UseGpu}"
                                     VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ParseStatus}"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>

                    <ProgressBar Value="{Binding ParseProgress}"
                                 Minimum="0" Maximum="100"
                                 Height="18"/>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Elapsed:" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock Text="{Binding ParseElapsedDisplay}"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="ETA:" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock Text="{Binding ParseEtaDisplay}"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="DeepSkyBlue"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Rate:" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock Text="{Binding ParseRateDisplay}"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="LightGreen"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Start Parsing"
                                Command="{Binding StartParsingCommand}"
                                Padding="16,6"/>
                        <Button Content="Stop"
                                Command="{Binding StopParsingCommand}"
                                Padding="16,6"/>
                    </StackPanel>

                    <TextBlock Text="Reads data/shots/{ticker}_{timeframe}_NNNN_{DATE,TIME,O,H,L,C,V}.png. Batches all seven crops into one OCR call per step. DATE/TIME are optional. On failure, the step indices are written to data/parsed/{ticker}_{timeframe}_misses.txt for the Re-extract flow on the Extraction tab."
                               Foreground="Gray"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ══════════ ANALYSIS ══════════ -->
        <TabItem Header="Analysis">
            <ScrollViewer>
                <StackPanel Spacing="12" Margin="4" Width="620" HorizontalAlignment="Left">
                    <TextBlock Text="Parsed Data Analysis" FontWeight="Bold" FontSize="14"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Path:" VerticalAlignment="Center" Width="70"/>
                        <TextBox Text="{Binding AnalysisPath}" Width="400"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Timezone Offset:" VerticalAlignment="Center" Width="110"/>
                        <NumericUpDown Value="{Binding AnalysisTimezoneOffset}"
                                       Minimum="-12" Maximum="14"
                                       ShowButtonSpinner="False"
                                       Width="160"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Session Closed Hours:" VerticalAlignment="Center" Width="140"/>
                        <TextBox Text="{Binding AnalysisSessionClosedHours}" Width="200" Watermark="0,1"/>
                    </StackPanel>

                    <CheckBox Content="Skip Weekend" IsChecked="{Binding AnalysisSkipWeekend}"/>

                    <Button Content="Analyze" Command="{Binding AnalyzeCommand}" Padding="16,6" HorizontalAlignment="Left"/>

                    <TextBox Text="{Binding AnalysisResultText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="400"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="11"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>