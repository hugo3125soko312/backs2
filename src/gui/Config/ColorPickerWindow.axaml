<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="backs2.Views.ColorPickerWindow"
        Title="Pick Color"
        Width="380" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="None"
        Background="#0D1117">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="16">

        <primitives:ColorSpectrum x:Name="Spectrum"
                                   Grid.Row="0"
                                   Width="280" Height="280"
                                   Shape="Ring"
                                   Components="HueSaturation"
                                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="0,14,0,0" Spacing="4">
            <TextBlock Text="Brightness" FontSize="11" Foreground="#848D97"/>
            <Slider x:Name="ValueSlider"
                    Minimum="0" Maximum="100"
                    Width="320"
                    HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0" Spacing="6">
            <Grid ColumnDefinitions="80,*">
                <primitives:ColorPreviewer Grid.Column="0"
                                            Width="80" Height="34"
                                            HsvColor="{Binding #Spectrum.HsvColor}"
                                            IsAccentColorsVisible="False"/>
                <TextBox Grid.Column="1"
                         x:Name="HexBox"
                         Margin="10,0,0,0"
                         Watermark="#RRGGBB"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="13"
                         VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="RgbLabel"
                       FontSize="10"
                       Opacity="0.6"
                       Foreground="#848D97"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80"/>
            <Button x:Name="OkButton" Content="OK" Width="80"/>
        </StackPanel>
    </Grid>
</Window>