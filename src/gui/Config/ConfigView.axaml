<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.ConfigView"
             x:DataType="vm:ConfigViewModel">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">

            <TextBlock Text="Engine Settings" FontSize="18" FontWeight="Bold"/>

            <Label Content="Max Threads"/>
            <NumericUpDown Value="{Binding MaxThreads}" Minimum="1" Maximum="64"/>

            <Label Content="Max Retries"/>
            <NumericUpDown Value="{Binding MaxRetries}" Minimum="0" Maximum="10"/>

            <Label Content="Timeout (Seconds)"/>
            <NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="300"/>

            <TextBlock Text="Provider Order (first success wins)"
                       FontSize="14" FontWeight="SemiBold"
                       Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto">

                <!-- Available -->
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Text="Available" FontSize="11" Opacity="0.7"/>
                    <ListBox ItemsSource="{Binding AvailableProviders}"
                             SelectedItem="{Binding SelectedAvailable, Mode=TwoWay}"
                             Height="120"/>
                </StackPanel>

                <!-- Center buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4" Margin="8,0">
                    <Button Content="→" Command="{Binding AddProviderCommand}" Width="32"/>
                    <Button Content="←" Command="{Binding RemoveProviderCommand}" Width="32"/>
                </StackPanel>

                <!-- Current order -->
                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                    <TextBlock Text="In Order" FontSize="11" Opacity="0.7"/>
                    <ListBox ItemsSource="{Binding ProviderOrder}"
                             SelectedItem="{Binding SelectedInOrder, Mode=TwoWay}"
                             Height="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button Content="↑" Command="{Binding MoveUpCommand}" Width="32"/>
                        <Button Content="↓" Command="{Binding MoveDownCommand}" Width="32"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Button Content="Save Settings"
                    Command="{Binding SaveCommand}"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>