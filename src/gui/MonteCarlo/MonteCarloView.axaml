<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             xmlns:core="using:backs2.Core.Overview"
             xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             x:Class="backs2.Views.MonteCarloView"
             x:DataType="vm:MonteCarloViewModel">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBg"       Color="#181818" />
        <SolidColorBrush x:Key="CardHeaderBg" Color="#202020" />
        <SolidColorBrush x:Key="CardBorder"   Color="#2A2A2A" />
        <SolidColorBrush x:Key="CardRule"     Color="#242424" />
        <SolidColorBrush x:Key="CardLabelFg"  Color="#9A9A9A" />
        <SolidColorBrush x:Key="CardHeaderFg" Color="#B0B0B0" />
        <SolidColorBrush x:Key="CardValueFg"  Color="#E6E6E6" />
        <SolidColorBrush x:Key="BannerBg"     Color="#14202E" />
        <SolidColorBrush x:Key="BannerFg"     Color="#7FC7F5" />
        <SolidColorBrush x:Key="TabStripBg"   Color="#181818" />
        <SolidColorBrush x:Key="TabActiveBg"  Color="#242424" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">

        <StackPanel Grid.Row="0" Spacing="0" Margin="0,0,0,8">

            <ToggleButton IsChecked="{Binding IsSettingsExpanded, Mode=TwoWay}"
                          HorizontalAlignment="Left"
                          Padding="14,4"
                          MinHeight="0"
                          CornerRadius="4,4,0,0"
                          Background="{StaticResource TabStripBg}"
                          BorderBrush="{StaticResource CardBorder}"
                          BorderThickness="1">
                <ToggleButton.Styles>
                    <Style Selector="ToggleButton:checked">
                        <Setter Property="Background" Value="{StaticResource TabActiveBg}" />
                    </Style>
                </ToggleButton.Styles>
                <TextBlock Text="SETTINGS"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CardHeaderFg}" />
            </ToggleButton>

            <Border IsVisible="{Binding IsSettingsExpanded}"
                    Background="#141414"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="0,4,4,4"
                    Padding="16,12">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,110,20,Auto,90,20,Auto,90,*,Auto">
                        <TextBlock Grid.Column="0" Text="Iterations"
                                   Foreground="{StaticResource CardLabelFg}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding Iterations, Mode=TwoWay}"
                                       Minimum="10" Maximum="1000000" Increment="100"
                                       FormatString="0" ShowButtonSpinner="False" />

                        <TextBlock Grid.Column="3" Text="Block Size"
                                   Foreground="{StaticResource CardLabelFg}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Column="4"
                                       Value="{Binding MeanBlockSize, Mode=TwoWay}"
                                       Minimum="1" Maximum="100" Increment="1"
                                       FormatString="0" ShowButtonSpinner="False" />

                        <TextBlock Grid.Column="6" Text="Ruin Threshold %"
                                   Foreground="{StaticResource CardLabelFg}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Column="7"
                                       Value="{Binding RuinThresholdPercent, Mode=TwoWay}"
                                       Minimum="1" Maximum="99" Increment="1"
                                       FormatString="0" ShowButtonSpinner="False" />

                        <TextBlock Grid.Column="9"
                                   Text="{Binding ActiveAccountName}"
                                   Foreground="{StaticResource BannerFg}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,Auto,240,*,Auto">
                        <Button Grid.Column="0"
                                Content="Run Monte Carlo"
                                Command="{Binding RunCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Padding="18,6" />

                        <Button Grid.Column="1"
                                Content="Test Worker"
                                Command="{Binding TestWorkerCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Padding="12,6"
                                Margin="8,0,0,0"
                                ToolTip.Tip="Runs the process-isolated compute worker on the Phase 1 placeholder job" />

                        <ProgressBar Grid.Column="2"
                                     Value="{Binding Progress}"
                                     Minimum="0" Maximum="100"
                                     Height="4"
                                     Margin="12,0,12,0"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsBusy}" />

                        <TextBlock Grid.Column="4"
                                   Text="{Binding CurveMemoryLabel}"
                                   FontSize="11"
                                   Foreground="{StaticResource CardLabelFg}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource BannerBg}"
                CornerRadius="4"
                Padding="12,6"
                Margin="0,0,0,8">
            <TextBlock Text="{Binding SourceInfo}"
                       FontSize="11"
                       Foreground="{StaticResource BannerFg}" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="440,6,*">

            <Border Grid.Column="0"
                    Background="#0F0F0F"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10">
                    <StackPanel Spacing="12">

                        <StackPanel IsVisible="{Binding HasResults}" Spacing="8">
                            <TextBlock Text="PER-DATASET OUTCOMES"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CardHeaderFg}" />

                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding BatchItems}"
                                      SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}"
                                      IsVisible="{Binding HasBatch}"
                                      PlaceholderText="(auto)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="core:OverviewData">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                                            <TextBlock Text="@" Opacity="0.5" />
                                            <TextBlock Text="{Binding Timeframe}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Border Background="{StaticResource CardHeaderBg}"
                                    CornerRadius="4"
                                    Padding="10,4">
                                <Grid ColumnDefinitions="*,60,60,60">
                                    <TextBlock Grid.Column="0" Text="Dataset"  FontSize="10" Foreground="{StaticResource CardHeaderFg}" />
                                    <TextBlock Grid.Column="1" Text="Ruin"     FontSize="10" Foreground="{StaticResource CardHeaderFg}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Funded"   FontSize="10" Foreground="{StaticResource CardHeaderFg}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Timeout"  FontSize="10" Foreground="{StaticResource CardHeaderFg}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding BatchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:McBatchRow">
                                        <Border BorderBrush="{StaticResource CardRule}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,4">
                                            <Grid ColumnDefinitions="*,60,60,60">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Display}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource CardValueFg}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PRuinText}"
                                                           FontSize="11" Foreground="#EF5350"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding PFundedText}"
                                                           FontSize="11" Foreground="#26A69A"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding PTimeoutText}"
                                                           FontSize="11" Foreground="{StaticResource CardLabelFg}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="SELECTED DATASET"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CardHeaderFg}"
                                   IsVisible="{Binding HasResults}" />

                        <ItemsControl ItemsSource="{Binding Kpis}" IsVisible="{Binding HasResults}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:McKpiCard">
                                    <Border Background="{StaticResource CardBg}"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,8,8"
                                            Padding="14,12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource CardHeaderFg}" />
                                            <TextBlock Text="{Binding Value}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding ValueBrush}" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource CardLabelFg}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Stats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:McStatSection">
                                    <Border Background="{StaticResource CardBg}"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <Border Background="{StaticResource CardHeaderBg}"
                                                    CornerRadius="6,6,0,0"
                                                    Padding="12,6">
                                                <TextBlock Text="{Binding Header}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource CardHeaderFg}" />
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:McStatLine">
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              Margin="12,4">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Label}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource CardLabelFg}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Value}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding ValueBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="12,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Background="{StaticResource CardBorder}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

            <Border Grid.Column="2"
                    Background="#0F0F0F"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="6,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="{StaticResource CardHeaderBg}"
                            CornerRadius="6,6,0,0"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="PLOT"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CardHeaderFg}"
                                       VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding PlotModes}"
                                      SelectedItem="{Binding SelectedPlotModeOption, Mode=TwoWay}"
                                      Width="160"
                                      VerticalAlignment="Center"
                                      IsEnabled="{Binding !ShowEquityCurves}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:PlotModeOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <CheckBox Content="Equity Curves"
                                      IsChecked="{Binding ShowEquityCurves, Mode=TwoWay}"
                                      Foreground="{StaticResource CardLabelFg}"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <ScottPlot:AvaPlot x:Name="HistogramPlot"
                                           IsVisible="{Binding IsHistogramVisible}" />
                        <ScottPlot:AvaPlot x:Name="CurvesPlot"
                                           IsVisible="{Binding IsCurvesVisible}" />
                        <ScottPlot:AvaPlot x:Name="ClusterPlot"
                                           IsVisible="{Binding IsClusterVisible}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="#141414"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,6"
                Margin="0,8,0,0"
                CornerRadius="0,0,4,4">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{StaticResource CardLabelFg}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>