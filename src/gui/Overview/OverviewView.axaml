<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding StrategyName}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding Symbol}"
                       FontSize="12"
                       Opacity="0.75" />
            <TextBlock Text="{Binding RunInfo}"
                       FontSize="11"
                       Opacity="0.6" />
        </StackPanel>

        <!-- Batch summary banner -->
        <Border Grid.Row="1"
                Background="#1A4FC3F7"
                Padding="8,4"
                Margin="0,0,0,8">
            <TextBlock Text="{Binding BatchSummary}"
                       FontSize="11"
                       Foreground="#B0E0FF"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Per-dataset DataGrid -->
        <Border Grid.Row="2"
                BorderThickness="1"
                BorderBrush="#333">
            <DataGrid ItemsSource="{Binding Rows}"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsVisible="{Binding HasRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dataset"
                                        Binding="{Binding SymbolDisplay}"
                                        Width="*" />
                    <DataGridTextColumn Header="Trades"
                                        Binding="{Binding TradesText}"
                                        Width="90" />
                    <DataGridTextColumn Header="Net PnL"
                                        Binding="{Binding NetPnlText}"
                                        Width="120" />
                    <DataGridTextColumn Header="Win %"
                                        Binding="{Binding WinRateText}"
                                        Width="90" />
                    <DataGridTextColumn Header="Duration"
                                        Binding="{Binding DurationText}"
                                        Width="110" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Aggregate footer (pinned) -->
        <Border Grid.Row="3"
                BorderThickness="0,1,0,0"
                BorderBrush="#4FC3F7"
                Background="#0A1A242E"
                Padding="8,6"
                Margin="0,4,0,0"
                IsVisible="{Binding HasRows}">
            <Grid ColumnDefinitions="*,90,120,90,110,80">
                <TextBlock Grid.Column="0"
                           Text="Aggregate"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Aggregate.TotalTradesText}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Aggregate.TotalNetPnlText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="{Binding Aggregate.WeightedWinRateText}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4"
                           Text="{Binding Aggregate.TotalDurationText}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="5"
                           Text=""
                           FontSize="12" />
            </Grid>
        </Border>

        <!-- Status line -->
        <TextBox Grid.Row="4"
                 Text="{Binding StatusText}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="0,6,0,0"
                 FontSize="11"
                 Opacity="0.8" />
    </Grid>
</UserControl>