<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding StrategyName}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding Symbol}"
                       FontSize="12"
                       Opacity="0.75" />
            <TextBlock Text="{Binding RunInfo}"
                       FontSize="11"
                       Opacity="0.6" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#1A4FC3F7"
                Padding="8,4"
                Margin="0,0,0,8">
            <TextBlock Text="Overview placeholder — in-sample metrics, Monte Carlo summary, and equity curve land in Phase 10.11D."
                       FontSize="11"
                       Foreground="#B0E0FF"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2"
                BorderThickness="1"
                BorderBrush="#333">
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Opacity="0.5"
                       FontSize="12" />
        </Border>

        <TextBox Grid.Row="3"
                 Text="{Binding StatusText}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="0,4,0,0"
                 FontSize="11"
                 Opacity="0.8" />
    </Grid>
</UserControl>