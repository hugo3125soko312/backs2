<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             xmlns:core="using:backs2.Core"
             x:Class="backs2.Views.DataView"
             x:DataType="vm:DataViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Filter-active: accent the TextBox border + text when it has content. -->
        <Style Selector="TextBox.filtered">
            <Setter Property="BorderBrush" Value="#4FC3F7" />
            <Setter Property="Foreground" Value="#4FC3F7" />
        </Style>

        <!-- Sort glyph: accent color, small, tight. -->
        <Style Selector="TextBlock.sortGlyph">
            <Setter Property="Foreground" Value="#4FC3F7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Header button content: label + glyph on one line. -->
        <Style Selector="Button.sortHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8">
            <Button Content="Refresh"
                    Command="{Binding RefreshDataCommand}" />
        </StackPanel>

        <!-- Datasheet: filters live inside the column headers -->
        <Border Grid.Row="1"
                Margin="8,0,8,8"
                BorderThickness="1"
                BorderBrush="#333">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      RowHeight="22">

                <DataGrid.Columns>

                    <!-- ===== Symbol ===== -->
                    <DataGridTemplateColumn Header="Symbol" Width="180">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Classes="sortHeader"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="Symbol">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Symbol" />
                                            <TextBlock Classes="sortGlyph"
                                                       Text="{Binding DataContext.SymbolSortGlyph,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Classes.filtered="{Binding DataContext.HasFilterSymbol,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding DataContext.FilterSymbol,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding Symbol}" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ===== Source ===== -->
                    <DataGridTemplateColumn Header="Source" Width="100">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Classes="sortHeader"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="Source">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Source" />
                                            <TextBlock Classes="sortGlyph"
                                                       Text="{Binding DataContext.SourceSortGlyph,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Classes.filtered="{Binding DataContext.HasFilterSource,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding DataContext.FilterSource,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding Source}" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ===== Size ===== -->
                    <DataGridTemplateColumn Header="Size (bytes)" Width="120">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Classes="sortHeader"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="SizeBytes">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Size" />
                                            <TextBlock Classes="sortGlyph"
                                                       Text="{Binding DataContext.SizeSortGlyph,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Classes.filtered="{Binding DataContext.HasFilterSize,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding DataContext.FilterSize,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding SizeDisplay}" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ===== Last Modified ===== -->
                    <DataGridTemplateColumn Header="Last Modified" Width="160">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Classes="sortHeader"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="LastModifiedUtc">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Modified" />
                                            <TextBlock Classes="sortGlyph"
                                                       Text="{Binding DataContext.ModifiedSortGlyph,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Classes.filtered="{Binding DataContext.HasFilterModified,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding DataContext.FilterModified,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding LastModifiedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                           VerticalAlignment="Center"
                                           Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ===== Path ===== -->
                    <DataGridTemplateColumn Header="Path" Width="*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Classes="sortHeader"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="Path">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Path" />
                                            <TextBlock Classes="sortGlyph"
                                                       Text="{Binding DataContext.PathSortGlyph,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Classes.filtered="{Binding DataContext.HasFilterPath,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding DataContext.FilterPath,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding Path}"
                                           VerticalAlignment="Center"
                                           Margin="4,0"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Margin="8,0,8,8"
                   FontSize="11"
                   Opacity="0.8" />
    </Grid>
</UserControl>