<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.DataView"
             x:DataType="vm:DataViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8">

        <!-- Row 0: fetch form -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Symbol:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox Width="140"
                     Text="{Binding FetchSymbol, Mode=TwoWay}"
                     Watermark="XAUUSD"
                     VerticalAlignment="Center" />

            <TextBlock Text="Timeframe:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox Width="90"
                      ItemsSource="{Binding AvailableTimeframes}"
                      SelectedItem="{Binding FetchTimeframe, Mode=TwoWay}"
                      VerticalAlignment="Center" />

            <TextBlock Text="Provider:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox Width="130"
                      ItemsSource="{Binding AvailableProviders}"
                      SelectedItem="{Binding FetchProvider, Mode=TwoWay}"
                      VerticalAlignment="Center" />

            <Button Content="Fetch"
                    Command="{Binding FetchCommand}"
                    IsEnabled="{Binding !IsFetching}" />
            <Button Content="Fetch &amp; Queue"
                    Command="{Binding FetchAndQueueCommand}"
                    IsEnabled="{Binding !IsFetching}" />

            <ProgressBar Width="160"
                         Minimum="0" Maximum="100"
                         Value="{Binding FetchProgress}"
                         IsIndeterminate="{Binding IsFetchProgressIndeterminate}"
                         IsVisible="{Binding IsFetching}"
                         VerticalAlignment="Center" />

            <TextBlock Text="{Binding FetchStatus}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Row 1: toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Refresh" Command="{Binding RefreshDataCommand}" />
            <Button Content="Queue..." Command="{Binding OpenQueueCommand}" />
            <TextBlock Text="{Binding QueuedCount, StringFormat='{}{0} queued'}"
                       VerticalAlignment="Center"
                       Foreground="#4FC3F7" />
        </StackPanel>

        <!-- Row 2: filter row -->
        <Grid Grid.Row="2" ColumnDefinitions="44,2*,1*,1.2*,1.2*,70,1*,1.5*,1.5*,3*" Margin="0,0,0,4">
            <TextBox Grid.Column="1" Text="{Binding FilterSymbol, Mode=TwoWay}" Watermark="Symbol" Margin="0,0,4,0" />
            <TextBox Grid.Column="2" Text="{Binding FilterTimeframe, Mode=TwoWay}" Watermark="TF" Margin="0,0,4,0" />
            <TextBox Grid.Column="3" Text="{Binding FilterTier, Mode=TwoWay}" Watermark="Tier" Margin="0,0,4,0" />
            <TextBox Grid.Column="4" Text="{Binding FilterProvider, Mode=TwoWay}" Watermark="Provider" Margin="0,0,4,0" />
            <Border Grid.Column="5" Margin="0,0,4,0" />
            <TextBox Grid.Column="6" Text="{Binding FilterSize, Mode=TwoWay}" Watermark="Size" Margin="0,0,4,0" />
            <TextBox Grid.Column="7" Text="{Binding FilterModified, Mode=TwoWay}" Watermark="Modified" Margin="0,0,4,0" />
            <TextBox Grid.Column="8" Text="{Binding FilterRange, Mode=TwoWay}" Watermark="Range" Margin="0,0,4,0" />
            <TextBox Grid.Column="9" Text="{Binding FilterPath, Mode=TwoWay}" Watermark="Path" />
        </Grid>

        <!-- Row 3: Raw Ticks compile form (visible only when subtab == Raw Ticks) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                    IsVisible="{Binding IsRawTicksVisible}">
            <TextBlock Text="Source:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Border BorderBrush="#30363D" BorderThickness="1" Padding="8,4" MinWidth="260" CornerRadius="3">
                <TextBlock Text="{Binding CompileSourceLabel}" VerticalAlignment="Center" FontSize="12" />
            </Border>
            <TextBlock Text="Timeframe:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox Width="90" SelectedItem="{Binding CompileTimeframe, Mode=TwoWay}">
                <ComboBoxItem Content="1m" />
                <ComboBoxItem Content="5m" />
                <ComboBoxItem Content="15m" />
                <ComboBoxItem Content="30m" />
                <ComboBoxItem Content="1h" />
                <ComboBoxItem Content="4h" />
                <ComboBoxItem Content="1D" />
            </ComboBox>
            <Button Content="Compile" Command="{Binding CompileCommand}" IsEnabled="{Binding !IsCompiling}" />
            <Button Content="Compile &amp; Queue" Command="{Binding CompileAndQueueCommand}" IsEnabled="{Binding !IsCompiling}" />
            <ProgressBar Width="160" Minimum="0" Maximum="100" Value="{Binding CompileProgress}"
                         IsVisible="{Binding IsCompiling}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CompileStatus}" VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
        </StackPanel>
        <!-- Row 3: data grid -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <!-- "On" column: group header shows a bulk-select checkbox,
                     data rows show the per-dataset checkbox. -->
                <DataGridTemplateColumn Header="On" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <Grid>
                                <CheckBox IsChecked="{Binding IsQueued, Mode=TwoWay}"
                                          IsVisible="{Binding !IsGroupHeader}"
                                          HorizontalAlignment="Center" />
                                <CheckBox IsChecked="{Binding IsGroupSelected, Mode=TwoWay}"
                                          IsVisible="{Binding IsGroupHeader}"
                                          HorizontalAlignment="Center"
                                          ToolTip.Tip="Select / deselect every visible timeframe in this ticker" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Symbol" Width="2*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="Symbol">
                                <TextBlock Text="{Binding DataContext.SymbolSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Symbol {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <Grid>
                                <TextBlock Text="{Binding Symbol}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsGroupHeader}" />
                                <TextBlock Text="{Binding GroupLabel}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsGroupHeader}"
                                           FontWeight="Bold"
                                           Foreground="#4FC3F7" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Timeframe" Width="1*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="Timeframe">
                                <TextBlock Text="{Binding DataContext.TimeframeSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Timeframe {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <TextBlock Text="{Binding Timeframe}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsGroupHeader}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Tier" Width="1.2*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="Tier">
                                <TextBlock Text="{Binding DataContext.TierSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Tier {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <TextBlock Text="{Binding Tier}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsGroupHeader}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Provider" Width="1.2*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="Provider">
                                <TextBlock Text="{Binding DataContext.ProviderSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Provider {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <TextBlock Text="{Binding Provider}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsGroupHeader}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Has Vol" Width="70">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="HasVolume">
                                <TextBlock Text="{Binding DataContext.HasVolumeSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Vol {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <CheckBox IsChecked="{Binding HasVolume}"
                                      IsHitTestVisible="False"
                                      IsVisible="{Binding !IsGroupHeader}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Size" Width="1*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="SizeBytes">
                                <TextBlock Text="{Binding DataContext.SizeSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Size {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <TextBlock Text="{Binding SizeDisplay}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsGroupHeader}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Modified" Width="1.5*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="LastModifiedLocal">
                                <TextBlock Text="{Binding DataContext.ModifiedSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Modified {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <TextBlock Text="{Binding LastModifiedLocal, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsGroupHeader}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Total Range" Width="1.5*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="RangeTicks">
                                <TextBlock Text="{Binding DataContext.RangeSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Total Range {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <TextBlock Text="{Binding RangeDisplay}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsGroupHeader}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Path" Width="3*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="Path">
                                <TextBlock Text="{Binding DataContext.PathSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Path {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <TextBlock Text="{Binding Path}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsGroupHeader}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 4: status line -->
        <TextBox Grid.Row="5"
                 Text="{Binding StatusText}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="0,6,0,0"
                 FontSize="11"
                 Opacity="0.8" />
    </Grid>
</UserControl>