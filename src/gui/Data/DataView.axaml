<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.DataView"
             x:DataType="vm:DataViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8">

        <!-- Row 0: fetch form -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Symbol:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox Width="140"
                     Text="{Binding FetchSymbol, Mode=TwoWay}"
                     Watermark="XAUUSD"
                     VerticalAlignment="Center" />

            <TextBlock Text="Timeframe:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox Width="90"
                      ItemsSource="{Binding AvailableTimeframes}"
                      SelectedItem="{Binding FetchTimeframe, Mode=TwoWay}"
                      VerticalAlignment="Center" />

            <Button Content="Fetch"
                    Command="{Binding FetchCommand}"
                    IsEnabled="{Binding !IsFetching}" />
            <Button Content="Fetch &amp; Queue"
                    Command="{Binding FetchAndQueueCommand}"
                    IsEnabled="{Binding !IsFetching}" />

            <ProgressBar Width="160"
                         Minimum="0" Maximum="100"
                         Value="{Binding FetchProgress}"
                         IsIndeterminate="{Binding IsFetchProgressIndeterminate}"
                         IsVisible="{Binding IsFetching}"
                         VerticalAlignment="Center" />

            <TextBlock Text="{Binding FetchStatus}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Row 1: existing toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Refresh" Command="{Binding RefreshDataCommand}" />
            <Button Content="Queue..." Command="{Binding OpenQueueCommand}" />
            <TextBlock Text="{Binding QueuedCount, StringFormat='{}{0} queued'}"
                       VerticalAlignment="Center"
                       Foreground="#4FC3F7" />
        </StackPanel>

        <!-- Row 2: filter row -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,1.2*,1.2*,1*,1.5*,3*" Margin="0,0,0,4">
            <TextBox Grid.Column="0" Text="{Binding FilterSymbol, Mode=TwoWay}" Watermark="Symbol" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Text="{Binding FilterTier, Mode=TwoWay}" Watermark="Tier" Margin="0,0,4,0" />
            <TextBox Grid.Column="2" Text="{Binding FilterProvider, Mode=TwoWay}" Watermark="Provider" Margin="0,0,4,0" />
            <TextBox Grid.Column="3" Text="{Binding FilterSize, Mode=TwoWay}" Watermark="Size" Margin="0,0,4,0" />
            <TextBox Grid.Column="4" Text="{Binding FilterModified, Mode=TwoWay}" Watermark="Modified" Margin="0,0,4,0" />
            <TextBox Grid.Column="5" Text="{Binding FilterPath, Mode=TwoWay}" Watermark="Path" />
        </Grid>

        <!-- Row 3: data grid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Rows}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="On" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <CheckBox IsChecked="{Binding IsQueued, Mode=TwoWay}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Symbol" Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="Symbol">
                                <TextBlock Text="{Binding DataContext.SymbolSortGlyph, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='Symbol {0}'}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DataRowViewModel">
                            <TextBlock Text="{Binding Symbol}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Timeframe" Binding="{Binding Timeframe}" Width="90" />
                <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="80" />
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="120" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" />
                <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 4: status line -->
        <TextBox Grid.Row="4"
                 Text="{Binding StatusText}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="0,6,0,0"
                 FontSize="11"
                 Opacity="0.8" />
    </Grid>
</UserControl>