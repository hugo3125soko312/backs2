<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             xmlns:core="using:backs2.Core"
             x:Class="backs2.Views.DataView"
             x:DataType="vm:DataViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8">
            <Button Content="Refresh"
                    Command="{Binding RefreshDataCommand}" />
            <Button Content="Clear Filters"
                    Command="{Binding ClearFiltersCommand}" />
        </StackPanel>

        <!-- Datasheet: filters live inside the column headers -->
        <Border Grid.Row="1"
                Margin="8,0,8,8"
                BorderThickness="1"
                BorderBrush="#333">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      RowHeight="22">

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Symbol" Width="180">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Content="Symbol ▲▼"
                                            FontSize="11"
                                            Padding="4,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="Symbol" />
                                    <TextBox Text="{Binding DataContext.FilterSymbol,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding Symbol}" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Source" Width="100">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Content="Source ▲▼"
                                            FontSize="11"
                                            Padding="4,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="Source" />
                                    <TextBox Text="{Binding DataContext.FilterSource,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding Source}" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Size (bytes)" Width="120">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Content="Size ▲▼"
                                            FontSize="11"
                                            Padding="4,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="SizeBytes" />
                                    <TextBox Text="{Binding DataContext.FilterSize,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding SizeBytes}" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Last Modified" Width="160">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Content="Modified ▲▼"
                                            FontSize="11"
                                            Padding="4,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="LastModifiedUtc" />
                                    <TextBox Text="{Binding DataContext.FilterModified,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding LastModifiedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                           VerticalAlignment="Center"
                                           Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Path" Width="*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,2">
                                    <Button Content="Path ▲▼"
                                            FontSize="11"
                                            Padding="4,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding DataContext.SortByCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="Path" />
                                    <TextBox Text="{Binding DataContext.FilterPath,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Mode=TwoWay}"
                                             Watermark="filter…"
                                             FontSize="11"
                                             Padding="2,0"
                                             MinHeight="18" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="core:DataEntry">
                                <TextBlock Text="{Binding Path}"
                                           VerticalAlignment="Center"
                                           Margin="4,0"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Margin="8,0,8,8"
                   FontSize="11"
                   Opacity="0.8" />
    </Grid>
</UserControl>