<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:backs2.ViewModels"
        x:Class="backs2.Views.QueueWindow"
        x:DataType="vm:QueueViewModel"
        Title="Queue"
        Width="620" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Window.Styles>
        <!-- Pending removal: dim + strike -->
        <Style Selector="ListBoxItem.pending">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="10">

        <Border Grid.Row="0"
                BorderThickness="1"
                BorderBrush="#333">
            <ListBox ItemsSource="{Binding Items}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:QueueRowViewModel">
                        <Grid ColumnDefinitions="Auto,150,100,*" Margin="4,2">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding Checked, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Symbol}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Timeframe}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Provider}"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"
                                       FontSize="11" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Opacity="0.8" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,8,0,0">
            <Button Content="Done"
                    Command="{Binding DoneCommand}" />
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>