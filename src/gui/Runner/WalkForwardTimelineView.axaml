<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             xmlns:views="using:backs2.Views"
             x:Class="backs2.Views.WalkForwardTimelineView"
             x:DataType="vm:RunnerViewModel">
    <Grid>
        <AvaPlot x:Name="AvaPlotControl"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch" />
        
        <!-- Summary overlay -->
        <TextBlock x:Name="SummaryText"
                   IsVisible="False"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="8"
                   Padding="4,2"
                   Background="{DynamicResource SurfaceOverlay}"
                   CornerRadius="3"
                   FontSize="11" />
    </Grid>
</UserControl>
