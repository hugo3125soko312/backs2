<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             xmlns:core="using:backs2.Core"
             x:Class="backs2.Views.RunnerView"
             x:DataType="vm:RunnerViewModel">

    <Grid ColumnDefinitions="280,4,*,4,280" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Grid.ColumnSpan="5"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8">

            <TextBlock Text="Symbol:" VerticalAlignment="Center" />
            <ComboBox Width="130"
                      ItemsSource="{Binding AvailableSymbols}"
                      SelectedItem="{Binding SelectedSymbol, Mode=TwoWay}" />
            <TextBox Width="110"
                     Watermark="or type..."
                     Text="{Binding SelectedSymbol, Mode=TwoWay}" />
            <Button Content="Refresh"
                    Command="{Binding RefreshSymbolsCommand}" />

            <TextBlock Text="Strategy:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Content="Refresh Catalog"
                    Command="{Binding RefreshCatalogCommand}" />

            <Button Content="Run"
                    Command="{Binding RunCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <Button Content="Presets..."
                    Command="{Binding OpenPresetsCommand}" />
            <Button Content="Save Preset..."
                    Command="{Binding SavePresetCommand}" />
        </StackPanel>

        <ListBox Grid.Row="1" Grid.Column="0"
                 ItemsSource="{Binding Strategies}"
                 SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                 Margin="8,0,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="core:StrategyDescriptor">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Path}"
                                   FontSize="10"
                                   Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="4"
                      Background="Transparent"
                      ResizeDirection="Columns" />

        <Border Grid.Row="1" Grid.Column="2"
                BorderThickness="1"
                BorderBrush="#333">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding SourcePreview}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="12"
                         Background="Transparent"
                         BorderThickness="0" />
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="3"
                      Width="4"
                      Background="Transparent"
                      ResizeDirection="Columns" />

        <Border Grid.Row="1" Grid.Column="4"
                Margin="0,0,8,0"
                Padding="8"
                BorderThickness="1"
                BorderBrush="#333"
                IsVisible="{Binding HasParameters}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RunnerParameterViewModel">
                            <StackPanel Margin="0,0,0,12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontSize="11"
                                               Opacity="0.75"
                                               Margin="0,0,0,2"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Save"
                                            FontSize="10"
                                            Padding="6,2"
                                            IsVisible="{Binding IsDirty}"
                                            ToolTip.Tip="Save current values as a preset"
                                            Command="{Binding DataContext.SavePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid>
                                <ComboBox ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding CurrentValue, Mode=TwoWay}"
                                          IsVisible="{Binding HasOptions}"
                                          HorizontalAlignment="Stretch" />
                                <TextBox Text="{Binding CurrentValue, Mode=TwoWay}"
                                         IsVisible="{Binding IsTextInput}"
                                         HorizontalAlignment="Stretch" />
                                <ToggleSwitch IsChecked="{Binding CurrentBool, Mode=TwoWay}"
                                              IsVisible="{Binding IsBoolToggle}"
                                              HorizontalAlignment="Left" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBox Grid.Row="2" Grid.ColumnSpan="5"
                 Text="{Binding StatusText}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="8,4,8,8"
                 FontSize="11"
                 Opacity="0.8" />
    </Grid>
</UserControl>