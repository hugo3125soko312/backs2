<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             xmlns:views="using:backs2.Views"
             x:Class="backs2.Views.RunnerView"
             x:DataType="vm:RunnerViewModel">
    <UserControl.Resources>
        <views:BoolToForegroundConverter x:Key="BoolToForegroundConverter"/>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <!-- ========== Toolbar ========== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,0,8,0">
            <TextBlock Text="Symbol:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Symbol}" VerticalAlignment="Center" Width="120"/>
            <Button Content="Refresh Catalog"
                    Command="{Binding RefreshCatalogCommand}"
                    Margin="16,0,0,0" />
            <Button Content="Run"
                    Command="{Binding RunCommand}"
                    IsEnabled="{Binding CanRun}" />
            <Button Content="Optimize"
                    Command="{Binding OptimizeCommand}"
                    ToolTip.Tip="Run walk-forward optimization: IS optimize per window, OOS evaluate, aggregate degradation" />
            <Button Content="Cancel"
                    Command="{Binding CancelOptimizeCommand}"
                    IsVisible="{Binding IsOptimizing}" />
            <ProgressBar Value="{Binding Progress}"
                         Maximum="{Binding MaxProgress}"
                         Width="200" />
            <TextBlock Text="{Binding EtaText}"
                       Foreground="{DynamicResource TextSecondary}" />
            <Button Content="Presets..."
                    Command="{Binding OpenPresetsCommand}"
                    Margin="16,0,0,0" />
            <Button Content="Open Folder..."
                    Command="{Binding OpenWalkForwardFolderCommand}"
                    FontSize="11" Padding="10,4" />
            <Button Content="Clear"
                    Command="{Binding ClearWalkForwardResultsCommand}"
                    FontSize="11" Padding="10,4" />
            <TextBlock Text="{Binding WalkForwardResultsCountText}"
                       FontSize="11" Opacity="0.75" Margin="8,0,0,0" />
        </StackPanel>

        <!-- ========== Walk-Forward Timeline panel ========== -->
        <views:WalkForwardTimelineView Grid.Row="3"
                      x:Name="TimelineView"
                      Margin="0,4,0,0" />

        <!-- ========== Status line ========== -->
        <TextBlock Grid.Row="4"
                   Text="Ready"
                   Padding="6"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondary}" />
    </Grid>
</UserControl>