<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:backs2.ViewModels"
        xmlns:core="using:backs2.Core.Runner"
        x:Class="backs2.Views.PresetPickerWindow"
        x:DataType="vm:PresetPickerViewModel"
        Title="Presets"
        Width="620" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <CheckBox Content="Show all strategies" IsChecked="{Binding ShowAll, Mode=TwoWay}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.75" FontSize="11" />
        </StackPanel>
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Presets}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Strategy" Binding="{Binding StrategyName}" Width="160" />
                <DataGridTextColumn Header="Preset" Binding="{Binding PresetName}" Width="*" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Load" Command="{Binding LoadCommand}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
