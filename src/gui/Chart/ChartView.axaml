<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             xmlns:oxy="clr-namespace:OxyPlot.Avalonia;assembly=OxyPlot.Avalonia"
             x:Class="backs2.Views.ChartView"
             x:DataType="vm:ChartViewModel">

    <UserControl.Styles>
        <Style Selector="Border.chartFrame">
            <Setter Property="Background" Value="#1E1E1E" />
        </Style>
        <Style Selector="Panel.chartHost">
            <Setter Property="Background" Value="#1E1E1E" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8">
            <TextBlock Text="Symbol:" VerticalAlignment="Center" />
            <ComboBox Width="130"
                      ItemsSource="{Binding AvailableSymbols}"
                      SelectedItem="{Binding SelectedSymbol, Mode=TwoWay}" />
            <TextBox Width="110"
                     Watermark="or type…"
                     Text="{Binding SelectedSymbol, Mode=TwoWay}" />
            <Button Content="⟳"
                    Command="{Binding RefreshSymbolsCommand}"
                    ToolTip.Tip="Rescan cached symbols" />

            <TextBlock Text="Timeframe:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox Width="90"
                      ItemsSource="{Binding AvailableTimeframes}"
                      SelectedItem="{Binding SelectedTimeframe, Mode=TwoWay}" />

            <Button Content="Load"
                    Command="{Binding LoadCommand}"
                    IsEnabled="{Binding !IsLoading}" />

            <ProgressBar Width="140"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1"
                Classes="chartFrame"
                Margin="8,0,8,8"
                BorderThickness="1"
                BorderBrush="#333"
                UseLayoutRounding="True">
            <Panel Classes="chartHost"
                   ClipToBounds="True">
                <Border Background="#1E1E1E" />
                <oxy:PlotView Model="{Binding PlotModel}"
                              UseLayoutRounding="True">
                    <oxy:PlotView.DefaultTrackerTemplate>
                        <ControlTemplate>
                            <oxy:TrackerControl Position="{Binding Position}"
                                                LineStroke="#888888"
                                                Background="#2A2A2A">
                                <oxy:TrackerControl.Content>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="White"
                                               FontSize="11"
                                               Margin="6,4" />
                                </oxy:TrackerControl.Content>
                            </oxy:TrackerControl>
                        </ControlTemplate>
                    </oxy:PlotView.DefaultTrackerTemplate>
                    <oxy:PlotView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Auto (fits data to screen)"
                                      Command="{Binding AutoScaleCommand}" />
                            <Separator />
                            <MenuItem Header="Logarithmic"
                                      Command="{Binding ToggleLogarithmicCommand}">
                                <MenuItem.Icon>
                                    <CheckBox IsChecked="{Binding IsLogarithmic}"
                                              IsHitTestVisible="False" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Percent"
                                      Command="{Binding TogglePercentCommand}">
                                <MenuItem.Icon>
                                    <CheckBox IsChecked="{Binding IsPercent}"
                                              IsHitTestVisible="False" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Indexed to 100"
                                      Command="{Binding ToggleIndexedCommand}">
                                <MenuItem.Icon>
                                    <CheckBox IsChecked="{Binding IsIndexedTo100}"
                                              IsHitTestVisible="False" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Invert scale"
                                      Command="{Binding ToggleInvertCommand}">
                                <MenuItem.Icon>
                                    <CheckBox IsChecked="{Binding IsInverted}"
                                              IsHitTestVisible="False" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </oxy:PlotView.ContextMenu>
                </oxy:PlotView>
            </Panel>
        </Border>

        <TextBox Grid.Row="2"
                 Text="{Binding StatusText}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="8,0,8,8"
                 FontSize="11"
                 Opacity="0.8" />
    </Grid>
</UserControl>