<UserControl x:Class="backs2.Views.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:backs2.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Text="Available Metrics"
                   FontWeight="Bold"
                   FontSize="16"
                   Margin="0,0,0,10"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Metrics}"
                 Background="{StaticResource PanelBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MetricInfo">
                    <Grid ColumnDefinitions="160,110,130,*" Margin="0,4">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Lag}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Category}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
