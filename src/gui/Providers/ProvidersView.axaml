<!-- src/gui/Providers/ProvidersView.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.ProvidersView"
             x:DataType="vm:ProvidersViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.hdr">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.groupHeader">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Padding" Value="4,4"/>
        </Style>
        <Style Selector="Border.datasetRow">
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style Selector="Border.datasetRow:nth-child(even)">
            <Setter Property="Background" Value="#1F1F1F"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="8">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Refresh Stats" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Column captions -->
                <Grid ColumnDefinitions="220,220,100,110,110,110,*" Margin="4,0,4,4">
                    <TextBlock Grid.Column="0" Classes="hdr" FontWeight="SemiBold" Text="Provider" />
                    <TextBlock Grid.Column="1" Classes="hdr" FontWeight="SemiBold" Text="Dataset" />
                    <TextBlock Grid.Column="2" Classes="hdr" FontWeight="SemiBold" Text="Volume" />
                    <TextBlock Grid.Column="3" Classes="hdr" FontWeight="SemiBold" Text="Start" />
                    <TextBlock Grid.Column="4" Classes="hdr" FontWeight="SemiBold" Text="End" />
                    <TextBlock Grid.Column="5" Classes="hdr" FontWeight="SemiBold" Text="Avg Span" />
                    <TextBlock Grid.Column="6" Classes="hdr" FontWeight="SemiBold" Text="Timeframes" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ProviderGroupViewModel">
                            <StackPanel>

                                <!-- Provider header row -->
                                <Border Classes="groupHeader">
                                    <Grid ColumnDefinitions="220,220,100,110,110,110,*">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <Button Content="{Binding ToggleGlyph}"
                                                    Command="{Binding ToggleExpandCommand}"
                                                    FontSize="10"
                                                    Padding="4,0"
                                                    MinWidth="20"
                                                    Background="Transparent"
                                                    BorderThickness="0" />
                                            <TextBlock Classes="hdr"
                                                       FontWeight="Bold"
                                                       Text="{Binding Provider}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="hdr"
                                                   Text="{Binding DatasetCount, StringFormat='{}{0} dataset(s)'}" />
                                        <TextBlock Grid.Column="2" Classes="hdr" Text="{Binding Volume}" />
                                        <TextBlock Grid.Column="3" Classes="hdr" Text="{Binding Start}" />
                                        <TextBlock Grid.Column="4" Classes="hdr" Text="{Binding End}" />
                                        <TextBlock Grid.Column="5" Classes="hdr" Text="{Binding AverageSpan}" />
                                        <TextBlock Grid.Column="6" Classes="hdr" Text="{Binding Timeframes}" />
                                    </Grid>
                                </Border>

                                <!-- Dataset child rows -->
                                <ItemsControl ItemsSource="{Binding Datasets}"
                                              IsVisible="{Binding IsExpanded}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ProviderDatasetRow">
                                            <Border Classes="datasetRow">
                                                <Grid ColumnDefinitions="220,220,100,110,110,110,*">
                                                    <TextBlock Grid.Column="0" Classes="cell" Text="" />
                                                    <TextBlock Grid.Column="1" Classes="cell"
                                                               Margin="16,0,8,0"
                                                               Text="{Binding Dataset}" />
                                                    <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Volume}" />
                                                    <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Start}" />
                                                    <TextBlock Grid.Column="4" Classes="cell" Text="{Binding End}" />
                                                    <TextBlock Grid.Column="5" Classes="cell" Text="{Binding Span}" />
                                                    <TextBlock Grid.Column="6" Classes="cell" Text="{Binding Timeframes}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <TextBox Grid.Row="2"
                 Text="{Binding StatusText}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="0,6,0,0"
                 FontSize="11"
                 Opacity="0.8" />
    </Grid>
</UserControl>