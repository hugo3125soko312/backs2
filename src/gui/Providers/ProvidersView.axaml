<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.ProvidersView"
             x:DataType="vm:ProvidersViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="8">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Refresh Stats" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- Grid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="150" />
                <DataGridTextColumn Header="Datasets" Binding="{Binding DatasetCount}" Width="80" />
                <DataGridTextColumn Header="Provides Volume" Binding="{Binding VolumeStatus}" Width="120" />
                <DataGridTextColumn Header="Earliest Data" Binding="{Binding EarliestDate}" Width="120" />
                <DataGridTextColumn Header="Latest Data" Binding="{Binding LatestDate}" Width="120" />
                <DataGridTextColumn Header="Timeframes Cached" Binding="{Binding Timeframes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <TextBox Grid.Row="2"
                 Text="{Binding StatusText}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="0,6,0,0"
                 FontSize="11"
                 Opacity="0.8" />
    </Grid>
</UserControl>