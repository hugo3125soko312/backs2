<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             xmlns:core="using:backs2.Core.Accounts"
             x:Class="backs2.Views.AccountView"
             x:DataType="vm:AccountViewModel">

    <Grid ColumnDefinitions="360,4,*" RowDefinitions="Auto,Auto,*,Auto">

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8">

            <TextBlock Text="Active:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActiveAccountName}"
                       VerticalAlignment="Center"
                       Foreground="#4FC3F7" />

            <Button Content="Set Active"
                    Command="{Binding SetActiveCommand}"
                    IsEnabled="{Binding HasSelection}"
                    Margin="16,0,0,0" />

            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}" />

            <Button Content="Open Folder"
                    Command="{Binding OpenFolderCommand}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="3"
                Background="#1A4FC3F7"
                Padding="8,4"
                Margin="8,0,8,4"
                IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding DetailSubHeader}"
                       FontSize="11"
                       Foreground="#B0E0FF" />
        </Border>

        <ListBox Grid.Row="2" Grid.Column="0"
                 ItemsSource="{Binding Accounts}"
                 SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                 Margin="8,0,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="core:AccountDescriptor">
                    <StackPanel>
                        <TextBlock Text="{Binding Firm}" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Opacity="0.7">
                            <Run Text="{Binding Plan}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Size}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="2" Grid.Column="1"
                      Width="4"
                      Background="Transparent"
                      ResizeDirection="Columns" />

        <Grid Grid.Row="2" Grid.Column="2"
              RowDefinitions="Auto,*,Auto"
              Margin="0,0,8,0">

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="{Binding DetailHeader}"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding DetailSubHeader}"
                           FontSize="11"
                           Opacity="0.7" />
            </StackPanel>

            <Border Grid.Row="1"
                    BorderThickness="1"
                    BorderBrush="#333">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PhaseRules}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:AccountRuleRow">
                                <Grid ColumnDefinitions="220,*" Margin="0,1">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="12" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="{Binding Notes}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.65"
                       Margin="0,8,0,0" />
        </Grid>

        <TextBox Grid.Row="3" Grid.ColumnSpan="3"
                 Text="{Binding StatusText}"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="8,4,8,8"
                 FontSize="11"
                 Opacity="0.8" />
    </Grid>
</UserControl>