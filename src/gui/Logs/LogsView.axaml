<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.LogsView"
             x:DataType="vm:LogsViewModel">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8">
            <Button Content="Refresh from File"
                    Command="{Binding RefreshCommand}" />
            <Button Content="Copy All"
                    Command="{Binding CopyAllCommand}" />
            <Button Content="Clear View"
                    Command="{Binding ClearViewCommand}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="8,0,8,8"
                BorderThickness="1"
                BorderBrush="#333">
            <ScrollViewer Name="LogScroll">
                <TextBox Text="{Binding LogText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="12"
                         Background="Transparent"
                         BorderThickness="0" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>