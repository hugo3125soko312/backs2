<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:backs2.ViewModels"
             x:Class="backs2.Views.LogsView"
             x:DataType="vm:LogsViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8">
            <Button Content="Refresh from File"
                    Command="{Binding RefreshCommand}" />
            <Button Content="Copy All"
                    Command="{Binding CopyAllCommand}" />
            <Button Content="Clear View"
                    Command="{Binding ClearViewCommand}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="8,0,8,0"
                BorderThickness="1"
                BorderBrush="#333">
            <ScrollViewer Name="LogScroll">
                <TextBox Text="{Binding LogText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="12"
                         Background="Transparent"
                         BorderThickness="0" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8">
            <TextBlock Text="&gt;"
                       VerticalAlignment="Center"
                       FontFamily="Consolas,Menlo,monospace"
                       FontSize="12"
                       Foreground="#4FC3F7" />
            <TextBox Name="CommandInputBox"
                     Width="600"
                     MaxHeight="80"
                     Text="{Binding CommandInput, Mode=TwoWay}"
                     Watermark="help — Enter runs, Shift+Enter adds a line"
                     FontFamily="Consolas,Menlo,monospace"
                     FontSize="12"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center" />
            <Button Content="Run"
                    Command="{Binding ExecuteCommandCommand}"
                    IsEnabled="{Binding !IsExecuting}" />
            <TextBlock Text="{Binding CommandStatus}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.7" />
        </StackPanel>
    </Grid>
</UserControl>